# ==========================================
# FaceNet // Task 3 Environment Variables
# ==========================================

# 1. SerpApi Key for Live Google Lens Reverse Image Search
# Obtain your free API key at: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# 2. Ganache EVM RPC Endpoint URL
GANACHE_URL=http://127.0.0.1:7545

# 3. Optional: Override with an existing deployed FaceRegistry contract address
# CONTRACT_ADDRESS=0x...

# 4. Next.js Backend URL (for frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
